.env
.config.yaml
.config.yml
.tmp
# Triage fixture .tmp residue from atomic-replace pattern (ADD-1):
# The line above only matches a bare `.tmp` basename. The redactor
# pipeline writes `early_failure_<pattern>_<run_id>.json.tmp` before
# atomic rename, so the .tmp EXTENSION must be ignored explicitly.
docs/triage-agent/fixtures/*.tmp
**/~$*.xlsx

# MCP config (contains PAT/credentials) — only .example files should be committed
**/mcp.json

# Generated automation artifacts
scripts/automation/mappings/
scripts/automation/.pipeline_state/
scripts/automation/models/
scripts/automation/logs/
scripts/automation/venv/

# E2E profile JSONs (not test fixtures — used with --profile-json during manual testing)
scripts/automation/tests/profile_*.json

# IDE files — commit shared settings, ignore personal/debug files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Workspace files — personal overrides (template is committed)
*.code-workspace

# Audit reports — point-in-time artifacts, stored in internal docs (Confluence/SharePoint)
AUDIT_REPORT.md

